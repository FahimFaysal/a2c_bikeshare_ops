{
  "datasets": [
    {
      "name": "release",
      "displayName": "Latest certified release",
      "queryLines": [
        "-- The one fully qualified name in this file: the status table lives in the ops schema, not in gold\n",
        "SELECT date_format(last_certified_at, 'yyyy-MM-dd HH:mm') AS last_certified_utc,\n",
        "       certified_releases, last_periods\n",
        "FROM workspace.prd_ops.release_status\n"
      ]
    },
    {
      "name": "heat",
      "displayName": "BQ1 hour x weekday",
      "queryLines": [
        "SELECT concat(weekday(start_date) + 1, ' ', start_dow) AS weekday, start_hour, sum(trips) AS trips\n",
        "FROM gold_demand_hourly GROUP BY ALL\n"
      ]
    },
    {
      "name": "monthly",
      "displayName": "BQ1 monthly demand and e-bike share",
      "queryLines": [
        "-- complete months only: a month with fewer than 27 days of data is a boundary stub\n",
        "SELECT period,\n",
        "       round(sum(trips) / count(DISTINCT start_date)) AS trips_per_day,\n",
        "       round(100 * sum(ebike_trips) / sum(trips), 1)  AS ebike_pct,\n",
        "       round(100 * sum(member_trips) / sum(trips), 1) AS member_pct\n",
        "FROM gold_weather_demand GROUP BY period HAVING count(DISTINCT start_date) >= 27 ORDER BY period\n"
      ]
    },
    {
      "name": "weather",
      "displayName": "BQ1 rain effect within each month",
      "queryLines": [
        "WITH d AS (SELECT period, start_date, max(is_rain_day) AS is_rain_day, sum(trips) AS trips\n",
        "           FROM gold_weather_demand GROUP BY period, start_date)\n",
        "SELECT period,\n",
        "       count_if(NOT is_rain_day) AS dry_days,\n",
        "       count_if(is_rain_day)     AS rain_days,\n",
        "       round(avg(CASE WHEN NOT is_rain_day THEN trips END)) AS dry_trips_per_day,\n",
        "       round(avg(CASE WHEN is_rain_day THEN trips END))     AS rain_trips_per_day,\n",
        "       round(100 * (avg(CASE WHEN is_rain_day THEN trips END) / avg(CASE WHEN NOT is_rain_day THEN trips END) - 1), 1) AS rain_vs_dry_pct\n",
        "FROM d GROUP BY period HAVING count(*) >= 27 ORDER BY period\n"
      ]
    },
    {
      "name": "flow",
      "displayName": "BQ2 top 20 draining and filling stations per peak",
      "queryLines": [
        "SELECT peak_window, direction, rank_in_list, system, station_name,\n",
        "       avg_departures_per_weekday, avg_arrivals_per_weekday, avg_net_flow_per_weekday, lat, lng\n",
        "FROM (\n",
        "  SELECT *, CASE WHEN avg_net_flow_per_weekday < 0 THEN 'drains' ELSE 'fills' END AS direction,\n",
        "         row_number() OVER (PARTITION BY peak_window, avg_net_flow_per_weekday < 0\n",
        "                            ORDER BY abs(avg_net_flow_per_weekday) DESC) AS rank_in_list\n",
        "  FROM gold_station_flow)\n",
        "WHERE rank_in_list <= 20\n",
        "ORDER BY peak_window, direction, rank_in_list\n"
      ]
    },
    {
      "name": "duration",
      "displayName": "BQ3 duration percentiles by month",
      "queryLines": [
        "SELECT period, concat(rideable_type, ' / ', member_type) AS bike_and_rider,\n",
        "       p50_duration_min, p90_duration_min\n",
        "FROM gold_ride_behaviour WHERE system = 'NYC' AND trips >= 1000 ORDER BY period\n"
      ]
    },
    {
      "name": "behaviour",
      "displayName": "BQ3 round trips and long rides",
      "queryLines": [
        "SELECT rideable_type, member_type, sum(trips) AS trips,\n",
        "       round(100 * sum(round_trips) / sum(trips), 2)       AS round_trip_pct,\n",
        "       round(100 * sum(trips_over_45_min) / sum(trips), 2) AS over_45_min_pct\n",
        "FROM gold_ride_behaviour GROUP BY ALL ORDER BY 1, 2\n"
      ]
    },
    {
      "name": "health",
      "displayName": "BQ4 busy stations that run empty or full",
      "queryLines": [
        "-- the 100 busiest matched stations, ordered by how often they were empty or full in the snapshots\n",
        "SELECT system, station_name, departures, snapshots,\n",
        "       round(100 * empty_share, 1) AS empty_pct, round(100 * full_share, 1) AS full_pct, lat, lng\n",
        "FROM (SELECT * FROM gold_station_health ORDER BY departures DESC LIMIT 100)\n",
        "ORDER BY greatest(empty_share, full_share) DESC LIMIT 20\n"
      ]
    }
  ],
